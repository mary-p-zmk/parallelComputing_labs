class someData {
public:
    string name = "Empty";
    string surname = "Empty";
    string address = "Empty";
    int age = 0;
};

class exchangePerson {
    public:
    someData data;
    mutex m;

    static void AlexanderMelnuk(exchangePerson& p) {
        lock_guard<mutex> guard(p.m);
        p.data.name = "Alexander";
        p.data.surname = "Melnuk";
        p.data.address = "Kyiv";
        p.data.age = 30;
    }

    static void OlhaShevchenco(exchangePerson& p) {
        lock_guard<mutex> guard(p.m);
        p.data.name = "Olha";
        p.data.surname = "Shevchenko";
        p.data.address = "Lviv";
        p.data.age = 25;
    }

    static void Swap_1_2_6(exchangePerson& p1, exchangePerson& p2) {
        if (&p1 == &p2) return;

        std::lock(p1.m, p2.m);
        lock_guard<mutex> lock1(p1.m, std::adopt_lock);
        lock_guard<mutex> lock2(p2.m, std::adopt_lock);

        swap(p1.data, p2.data);
    }

    static void Swap_1_2_7(exchangePerson& p1, exchangePerson& p2) {
        if (&p1 == &p2) return;

        unique_lock<mutex> lock1(p1.m, std::defer_lock);
        unique_lock<mutex> lock2(p2.m, std::defer_lock);
        std::lock(lock1, lock2);

        swap(p1.data, p2.data);
    }
    static void PrintData(const exchangePerson& p) {
        cout << "[" << p.data.name << ", " << p.data.surname << ", "
             << p.data.address << ", Age: " << p.data.age << "]\n";
    }
};

void Task_1_2_6() {
    cout << "\n--- Task 1.2.6 (std::lock & std::adopt_lock) ---\n";
    exchangePerson p1, p2;

    thread t1(&exchangePerson::AlexanderMelnuk, ref(p1));
    t1.detach();
    thread t2(&exchangePerson::OlhaShevchenco, ref(p2));
    t2.detach();

    this_thread::sleep_for(chrono::milliseconds(50));

    cout << "Before Swap:\n";
    exchangePerson::PrintData(p1);
    exchangePerson::PrintData(p2);

    thread t_swap(exchangePerson::Swap_1_2_6, ref(p1), ref(p2));
    t_swap.join();

    cout << "After Swap:\n";
    exchangePerson::PrintData(p1);
    exchangePerson::PrintData(p2);
}

void Task_1_2_7() {
    cout << "\n--- Task 1.2.7 (std::unique_lock & std::defer_lock) ---\n";
    exchangePerson p1, p2;

    thread t1(&exchangePerson::AlexanderMelnuk, ref(p1));
    t1.detach();
    thread t2(&exchangePerson::OlhaShevchenco, ref(p2));
